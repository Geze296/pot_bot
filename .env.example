# Copy to .env and fill in. Never commit .env.

# Required: from @BotFather (/newbot, then /setprivacy -> Disable)
BOT_TOKEN=

# Required: matches docker-compose.yml. Local development only.
DATABASE_URL=postgresql://potbot:potbot@localhost:5433/potbot

# Database password for `docker compose up`. Set your own on a server.
# If you change it, change DATABASE_URL too. A new password only applies to a new database.
POSTGRES_PASSWORD=potbot

# Host port for the Postgres container. Change DATABASE_URL too if you change this.
DB_PORT=5433

# Port for the Mini App and its API (Fastify)
API_PORT=3000

# Leave empty locally. The Docker image sets 0.0.0.0, so a host like Northflank can reach it.
API_HOST=

# The service's public HTTPS address, on a host like Northflank. With it set, the bot uses a webhook
# and offers the Mini App. Leave it empty locally, and the bot uses long polling.
PUBLIC_URL=

# Not used yet, because Telebirr receipt checks are deferred: Ethiopia relay for Telebirr receipts
RELAY_URL=
RELAY_SECRET=

# Optional: reads payment screenshots. With no key, they all go to the coordinator,
# and other AI features fall back to templates.
GEMINI_API_KEY=
